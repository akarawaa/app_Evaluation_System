# Copy to .env.local (Vite). Only VITE_* vars are exposed to the client.
# NEVER put the service_role key here — client gets the ANON key only.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=replace-me
VITE_API_BASE_URL=http://localhost:8000

# hr-portal launcher URL -- shows a small "← HR Suite" link in AppHeader.
# Leave empty to hide the link.
VITE_PORTAL_URL=https://hr-portal-jorgroup.vercel.app
