# Copy to .env and fill in. NEVER commit the real .env.
APP_ENV=local                     # local | staging | production
DEBUG=true                        # MUST be false in staging/production

# Database (SQLAlchemy + asyncpg). Use a NON-superuser, NON-BYPASSRLS role
# so RLS is enforced for tenant operations.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# Supabase project. JWTs are verified via the JWKS endpoint derived from
# SUPABASE_URL ({SUPABASE_URL}/auth/v1/.well-known/jwks.json) — Supabase signs
# user access tokens with ES256, so SUPABASE_URL must be reachable by the API.
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me      # admin only (tenant provisioning); keep secret
SUPABASE_JWT_SECRET=                      # legacy HS256 secret; not used for ES256 verification

# CORS: comma-separated allowlist of frontend origins (no "*")
CORS_ORIGINS=http://localhost:5173

# Brevo transactional email API for notices we compose ourselves
# (password-changed today; the deferred employee-acknowledgement email phase
# reuses this same account). NOT used for password reset itself -- that
# email is sent by Supabase Auth, configured separately in the Supabase
# dashboard / config.toml. Was SMTP; switched after Render was found to
# block all outbound SMTP at the network level (see services/email.py).
# Leave blank locally: local Supabase captures Auth emails in Mailpit
# regardless, and our own notices just log+skip when unset.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=ฝ่ายบุคคล

# Public URL of the deployed frontend -- used to build links in the daily
# digest email (services/notifications.py) back into the specific
# evaluation/inbox the recipient needs to act on.
FRONTEND_URL=http://localhost:5173

# Shared secret an external cron must send as header `X-Cron-Secret` to
# trigger POST /api/notifications/daily-digest (the once-a-day email digest
# that replaces per-event notifications -- see services/notifications.py for
# why). Leave blank to keep the endpoint disabled (fails closed, 403 always).
# Set up the external cron itself the same way as the UptimeRobot keep-alive
# ping already documented for cold starts -- any free scheduler that can
# POST with a custom header once a day works (e.g. cron-job.org).
CRON_SECRET=
